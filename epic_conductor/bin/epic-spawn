#!/usr/bin/env bash
# Start (or restart) one worker: scaffold its workbench with wsnew, then run a
# full-path-github session in a detached tmux session. Never switches your client.
# usage: epic-spawn <epic> <issue-url|owner/repo#n> [--dry-run] [--brief FILE] [--live] [--force]
#   --live        human-driven worker: plan-first prompt, normal permissions, never auto-restarted
#   --brief FILE  append FILE to the worker prompt (task-specific instructions)
#   --force       spawn even though the issue already used its $EPIC_MAX_ATTEMPTS attempts
set -euo pipefail
SRC="${BASH_SOURCE[0]}"; while [ -h "$SRC" ]; do D="$(cd -P "$(dirname "$SRC")" && pwd)"; SRC="$(readlink "$SRC")"; [[ $SRC != /* ]] && SRC="$D/$SRC"; done
HERE="$(cd -P "$(dirname "$SRC")" && pwd)"
source "$HERE/_common.sh"
[ $# -ge 2 ] || { echo "usage: epic-spawn <epic> <issue-url> [--dry-run] [--brief FILE] [--live] [--force]" >&2; exit 2; }
epic="$1"; ref="$2"; shift 2
dry=false; brief=""; live=false; force=false
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=true; shift ;;
    --live) live=true; shift ;;
    --force) force=true; shift ;;
    --brief) [ $# -ge 2 ] || { echo "--brief needs a file" >&2; exit 2; }; brief="$2"; shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done
[ -z "$brief" ] || [ -f "$brief" ] || { echo "brief not found: $brief" >&2; exit 2; }
validate_epic "$epic"
parse_issue "$ref"
url="$ISSUE_URL"
issue="$PROJECT_NAME/$IID"
sess="$(session_name "$epic" "$PROJECT_NAME" "$IID")"
wb="$(workbench_dir "$PROJECT_NAME" "$IID")"
run() { if $dry; then echo "DRY: $*"; else "$@"; fi; }

if tmux has-session -t "$sess" 2>/dev/null; then
  echo "worker already running: $sess" >&2; exit 1
fi

attempt="$(attempt_number "$epic" "$issue")"
if ! $live && ! $force && [ "$attempt" -gt "$EPIC_MAX_ATTEMPTS" ]; then
  echo "refusing: $issue already used $EPIC_MAX_ATTEMPTS attempts (respawn limit). Tell the user; --force overrides." >&2; exit 4
fi

mkdir -p "$EPIC_HOME/$epic/prompts"
prompt="$EPIC_HOME/$epic/prompts/${PROJECT_NAME}-${IID}-attempt${attempt}.md"
sed -e "s|{{ISSUE_URL}}|$url|g" -e "s|{{EPIC}}|$epic|g" -e "s|{{ISSUE_KEY}}|$issue|g" \
    -e "s|{{ATTEMPT}}|$attempt|g" -e "s|{{EPIC_LOG}}|$HERE/epic-log|g" \
    "$HERE/../prompts/$($live && echo worker-live.md || echo worker.md)" > "$prompt"
[ -z "$brief" ] || { printf '\n---\n\n'; cat "$brief"; } >> "$prompt"

[ -d "$wb" ] || run "${EPIC_WSNEW:-wsnew}" --yes --no-tmux "$url" --initiative "issue_$IID"
if $live; then
  flags=""
  $dry || { mkdir -p "$(dirname "$(live_file "$epic" "$PROJECT_NAME" "$IID")")"; printf '%s' "$sess" > "$(live_file "$epic" "$PROJECT_NAME" "$IID")"; }
else
  flags="--permission-mode bypassPermissions"
fi
run tmux new-session -d -s "$sess" -c "$wb" \
  "claude $flags \"\$(cat '$prompt')\"; exec \"\${SHELL:-zsh}\""
note="attempt $attempt"
$live && note="$note, LIVE"
note="$note, session $sess"
[ -z "$brief" ] || note="$note, brief $(basename "$brief")"
$dry || "$HERE/epic-log" "$epic" "$issue" STARTED "$note"
echo "spawned $sess (attempt $attempt)"
