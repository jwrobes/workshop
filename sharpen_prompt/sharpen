def require_pane():
    if not in_tmux() or not os.environ.get("TMUX_PANE"):
        die("this command needs to run inside a tmux pane")
    return os.environ["TMUX_PANE"]


def claim_sharpen(pair, pane_id, panes, force):
    others = [p for p in members(panes, pair, "sharpen") if p["id"] != pane_id]
    if others and not force:
        die(f"pair '{pair}' already has a sharpen pane ({others[0]['id']}); use --force to take over")
    for p in others:
        set_pane_membership(p["id"], None, None)
    state = pair_state(pair)
    state["sharpen_pane"] = pane_id
    save_pair_state(pair, state)


def parse_flags(args, flags_with_values=(), bool_flags=()):
    opts, rest = {}, []
    i = 0
    while i < len(args):
        a = args[i]
        if a in flags_with_values and i + 1 < len(args):
            opts[a] = args[i + 1]
            i += 2
        elif a in bool_flags:
            opts[a] = True
            i += 1
        else:
            rest.append(a)
            i += 1
    return opts, rest


def session_command(pair):
    """The claude command line for a sharpen session.

    Runs in bypassPermissions because the session's logging step appends to the skill's
    prompt_log.md under ~/.claude, a protected path that prompts in every other mode even with
    an allow rule. SHARPEN_PERMISSION_MODE=default opts back into the normal prompts.
    """
    cmd = ["claude", "--name", f"sharpen:{pair}"]
    mode = os.environ.get("SHARPEN_PERMISSION_MODE", "bypassPermissions")
    if mode != "default":
        cmd += ["--permission-mode", mode]
    if SESSION_PROMPT.exists():
        cmd += ["--append-system-prompt", SESSION_PROMPT.read_text()]
    return cmd


def cursor_session_command(pair):
    """The cursor-agent command line for a sharpen session.

    cursor-agent has no `--append-system-prompt`; persona is injected by the `sessionStart` hook
    (`sharpen hook session_start`), which reads `prompts/sharpen-session-cursor.md`. `-f` is the
    force-allow equivalent of Claude's bypassPermissions, needed so the session's logging step
    can append to the log without a prompt.
    """
    return ["cursor-agent", "-f"]


def _pick_agent(explicit):
    """Resolve --agent auto|claude|cursor to a concrete choice."""
    if explicit in ("claude", "cursor"):
        return explicit
    if explicit not in (None, "auto"):
        die(f"--agent must be auto|claude|cursor (got {explicit!r})")
    if shutil.which("claude"):
        return "claude"
    if shutil.which("cursor-agent"):
        return "cursor"
    die("neither 'claude' nor 'cursor-agent' found on PATH")


def cmd_session(args):
    opts, rest = parse_flags(args, flags_with_values=("--agent",), bool_flags=("--force",))
    pane_id = require_pane()
    panes = list_panes()
    pair = slugify(rest[0]) if rest else slug_from_cwd(os.getcwd())
    claim_sharpen(pair, pane_id, panes, opts.get("--force"))
    set_pane_membership(pane_id, pair, "sharpen")
    print(f"Pane {pane_id} is the sharpen pane for '{pair}'.")
    working = members(panes, pair, "working")
    if working:
        print("Working members: " + ", ".join(p["id"] for p in working))
    else:
        print(f"No working panes yet — in the working pane run: sharpen join {pair}")
    agent = _pick_agent(opts.get("--agent"))
    env = dict(os.environ, SHARPEN_PAIR=pair, SHARPEN_ROLE="sharpen")
    if agent == "claude":
        if not shutil.which("claude"):
            die("claude not found on PATH (try --agent cursor)")
        os.execvpe("claude", session_command(pair), env)
    else:  # cursor
        if not shutil.which("cursor-agent"):
            die("cursor-agent not found on PATH (try --agent claude)")
        os.execvpe("cursor-agent", cursor_session_command(pair), env)


def cmd_join(args):
