def command_help(name):
    """The usage block for one command, pulled from the module docstring."""
    lines = __doc__.strip().splitlines()
    out, capture = [], False
    for line in lines:
        starts_command = line.startswith("  sharpen ")
        if starts_command:
            capture = line.split()[1] == name or (name == "unpin" and line.split()[1] == "pin")
        elif not line.startswith(" " * 20):
            capture = False
        if capture:
            out.append(line)
    return "\n".join(out)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(CHEATSHEET)
        return
    if argv[0] == "help":
        if len(argv) > 1 and argv[1] == "commands":
            print(__doc__.strip())
        elif len(argv) > 1 and command_help(argv[1]):
            print(command_help(argv[1]))
        else:
            print(CHEATSHEET)
        return
    if len(argv) > 1 and argv[1] in ("-h", "--help") and argv[0] in COMMANDS:
        text = command_help(argv[0])
        print(text or f"sharpen {argv[0]} (internal; see `sharpen help commands`)")
        return
    fn = COMMANDS.get(argv[0])
    if not fn:
        die(f"unknown command '{argv[0]}' (see sharpen --help)", 2)
    fn(argv[1:])


if __name__ == "__main__":
    main(sys.argv[1:])
