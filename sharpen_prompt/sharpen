#!/usr/bin/env python3
"""sharpen — pair a sharpen-prompt Claude session with a working session.

Usage:
  sharpen session [PAIR] [--agent auto|claude|cursor]
                                      mark this tmux pane as PAIR's sharpen pane and launch an agent.
                                      --agent defaults to auto (prefers claude, else cursor-agent).
  sharpen join [PAIR] [--role R]      mark this pane as a member of PAIR (role: working|sharpen)
  sharpen leave                       clear this pane's pair/role
  sharpen pair [SELECTOR]             from a sharpen pane: switch to a pair name, or add a pane
                                      (%ID, left/right/up/down, cwd substring) as a working member.
                                      No selector: show the resolved target and candidates
  sharpen pin SELECTOR | unpin        force / release the target working pane for this pane's pair
  sharpen pairs                       list all pairs with their panes and current target
  sharpen status                      this pane's pair, role, resolved target, last copy
  sharpen copy [PAIR] [--from-pane %ID] [--quiet]
                                      re-copy the pair's last extracted message to the clipboard
                                      (--from-pane picks the pair from a pane; prefix+y uses it)
  sharpen last [SELECTOR]             print a pane's last-message snapshot
  sharpen deliver [--refine] [--pair P] [--from-pane %ID] [--voice]
                                      read text on stdin, paste it into the pair's sharpen pane
  sharpen resend [--force] [--pair P] [--from-pane %ID]
                                      deliver the last saved dictation again after a failure
  sharpen dictate [--refine] [--from-pane %ID] [dictate args...]
                                      run speak_to_code's dictate with --to-sharpen
  sharpen gc                          remove snapshots older than 24h
  sharpen hook stop|prompt|after_response|session_start
                                      hook entry points (read the event JSON on stdin).
                                      stop/prompt are Claude Code (Stop / UserPromptSubmit);
                                      after_response/session_start are Cursor CLI
                                      (afterAgentResponse / sessionStart).

Pair membership lives on tmux panes as user options @sharpen_pair / @sharpen_role, so a new
Claude session started in the same pane stays paired. Outside tmux, SHARPEN_PAIR / SHARPEN_ROLE
env vars set at launch do the same job. State lives in ~/.config/sharpen/.
"""

import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

STATE_DIR = Path(os.environ.get("SHARPEN_STATE_DIR", Path.home() / ".config" / "sharpen"))
SESSIONS_DIR = STATE_DIR / "sessions"
PAIRS_DIR = STATE_DIR / "pairs"
LOG_FILE = STATE_DIR / ".hook.log"
TOOL_DIR = Path(os.path.realpath(__file__)).parent
SESSION_PROMPT = TOOL_DIR / "prompts" / "sharpen-session.md"
CURSOR_SESSION_PROMPT = TOOL_DIR / "prompts" / "sharpen-session-cursor.md"
DICTATE = TOOL_DIR.parent / "speak_to_code" / "dictate"

SNAPSHOT_MAX_CHARS = 8000
SNAPSHOT_TTL_SECONDS = 24 * 3600
STALE_SECONDS = int(os.environ.get("SHARPEN_STALE_SECONDS", "600"))
ROLES = ("working", "sharpen")


# ── small utilities ──────────────────────────────────────────────────────────

def log(msg):
    try:
        private_dir(STATE_DIR)
        fd = os.open(LOG_FILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(f"[{datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}] {msg}\n")
    except OSError:
        pass


def die(msg, code=1):
    print(f"sharpen: {msg}", file=sys.stderr)
    sys.exit(code)


def now():
    return time.time()


def age_str(seconds):
    seconds = int(max(0, seconds))
    if seconds < 90:
        return f"{seconds}s ago"
    if seconds < 5400:
        return f"{seconds // 60}m ago"
    return f"{seconds // 3600}h ago"


def slugify(text):
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return slug or "default"


def slug_from_cwd(cwd):
    """Default pair name: the workbench initiative folder if inside one, else the folder name."""
    parts = Path(cwd).parts
    if "workbench" in parts:
        i = parts.index("workbench")
        if i + 1 < len(parts):
            return slugify(parts[i + 1])
    return slugify(Path(cwd).name)


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def private_dir(path):
    """Create path (and the state root) owner-only, tightening any looser existing mode."""
    for d in (STATE_DIR, path):
        d.mkdir(parents=True, exist_ok=True, mode=0o700)
        if (d.stat().st_mode & 0o777) != 0o700:
            d.chmod(0o700)


def write_private(path, text):
    private_dir(path.parent)
    tmp = path.with_suffix(path.suffix + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def write_json(path, data):
    write_private(path, json.dumps(data, indent=2))


# ── tmux ─────────────────────────────────────────────────────────────────────

PANE_FORMAT = "\t".join([
    "#{pane_id}", "#{session_name}", "#{window_id}", "#{window_index}", "#{pane_index}",
    "#{pane_left}", "#{pane_top}", "#{pane_current_path}", "#{pane_current_command}",
    "#{@sharpen_pair}", "#{@sharpen_role}",
])
PANE_FIELDS = ["id", "session", "window_id", "window_index", "pane_index",
               "left", "top", "cwd", "command", "pair", "role"]


def tmux(*args, input_text=None):
    try:
        r = subprocess.run(["tmux", *args], input=input_text, capture_output=True, text=True,
                           timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def in_tmux():
    return bool(os.environ.get("TMUX")) and shutil.which("tmux") is not None


def list_panes():
    out = tmux("list-panes", "-a", "-F", PANE_FORMAT)
    panes = []
    for line in (out or "").splitlines():
        vals = line.split("\t")
        if len(vals) != len(PANE_FIELDS):
            continue
        p = dict(zip(PANE_FIELDS, vals))
        p["left"], p["top"] = int(p["left"]), int(p["top"])
        p["pair"] = p["pair"] or None
        p["role"] = p["role"] or None
        panes.append(p)
    return panes


def pane_by_id(panes, pane_id):
    return next((p for p in panes if p["id"] == pane_id), None)


def set_pane_membership(pane_id, pair, role):
    if pair:
        tmux("set-option", "-p", "-t", pane_id, "@sharpen_pair", pair)
        tmux("set-option", "-p", "-t", pane_id, "@sharpen_role", role)
        tmux("select-pane", "-t", pane_id, "-T", f"{role}:{pair}")
    else:
        tmux("set-option", "-p", "-u", "-t", pane_id, "@sharpen_pair")
        tmux("set-option", "-p", "-u", "-t", pane_id, "@sharpen_role")


def notify(msg, pane_id=None):
    if in_tmux() or pane_id:
        args = ["display-message", "-d", "4000"]
        if pane_id:
            args += ["-t", pane_id]
        tmux(*args, msg)
    if os.environ.get("SHARPEN_MACOS_NOTIFY", "1") == "1" and shutil.which("osascript"):
        safe = msg.replace("\\", "\\\\").replace('"', '\\"')
        subprocess.run(["osascript", "-e", f'display notification "{safe}" with title "sharpen"'],
                       capture_output=True, timeout=5)


DISPLACE_WINDOW_SECONDS = 15 * 60


def sha(text):
    return hashlib.sha256(text.encode()).hexdigest()


def read_clipboard():
    if not shutil.which("pbpaste"):
        return None
    try:
        r = subprocess.run(["pbpaste"], capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def write_clipboard(text, pair=None):
    """System clipboard plus a tmux buffer named for the pair, so pairs never share a buffer."""
    ok = False
    if shutil.which("pbcopy"):
        ok = subprocess.run(["pbcopy"], input=text, text=True).returncode == 0
    if in_tmux():
        tmux("load-buffer", "-b", f"sharpen-{pair or 'last'}", "-", input_text=text)
    return ok


def pending_pair():
    """The pair whose sharpened message is still on the clipboard (copied under 15 minutes ago and
    not replaced by anything since), else None."""
    prev = read_json(STATE_DIR / "clipboard.json") or {}
    if not prev.get("pair") or now() - prev.get("at", 0) > DISPLACE_WINDOW_SECONDS:
        return None
    current = read_clipboard()
    return prev["pair"] if current is not None and sha(current) == prev.get("sha") else None


def copy_message(text, pair):
    """Copy a sharpened message to the clipboard.

    Returns the name of another pair whose message this replaced while it was still on the
    clipboard (copied under 15 minutes ago and not overwritten by anything else since), else None.
    Only a hash is remembered, never the text.
    """
    state_path = STATE_DIR / "clipboard.json"
    prev = read_json(state_path) or {}
    holder = pending_pair()
    displaced = holder if holder and holder != pair and prev.get("sha") != sha(text) else None
    write_clipboard(text, pair)
    write_json(state_path, {"pair": pair, "at": now(), "sha": sha(text), "chars": len(text)})
    return displaced


def resolve_selector(selector, panes, origin_id):
    """Resolve a pane selector: %ID, left/right/up/down (relative to origin), or cwd substring."""
    if selector.startswith("%"):
        return pane_by_id(panes, selector)
    origin = pane_by_id(panes, origin_id) if origin_id else None
    if selector in ("left", "right", "up", "down") and origin:
        same_window = [p for p in panes if p["window_id"] == origin["window_id"] and p is not origin]
        key = {"left": lambda p: p["left"] < origin["left"],
               "right": lambda p: p["left"] > origin["left"],
               "up": lambda p: p["top"] < origin["top"],
               "down": lambda p: p["top"] > origin["top"]}[selector]
        cands = [p for p in same_window if key(p)]
        dist = lambda p: abs(p["left"] - origin["left"]) + abs(p["top"] - origin["top"])
        return min(cands, key=dist) if cands else None
    matches = [p for p in panes if selector in p["cwd"] and p["id"] != origin_id]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        die(f"'{selector}' matches {len(matches)} panes ({', '.join(m['id'] for m in matches)}); "
            "use a pane id")
    return None


# ── snapshots ────────────────────────────────────────────────────────────────

def text_from_content(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(p.get("text", "") for p in content
                         if isinstance(p, dict) and p.get("type") == "text")
    return ""


def last_assistant_from_transcript(transcript_path):
    last = ""
    try:
        with open(transcript_path) as f:
            for line in f:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if entry.get("type") != "assistant":
                    continue
                text = text_from_content(entry.get("message", {}).get("content", ""))
                if text.strip():
                    last = text
    except OSError:
        pass
    return last


def write_snapshot(event, pane, pair, role):
    text = event.get("last_assistant_message") or ""
    if not text and event.get("transcript_path"):
        text = last_assistant_from_transcript(event["transcript_path"])
    return write_snapshot_text(
        text,
        session_id=event.get("session_id") or event.get("conversation_id", "unknown"),
        cwd=event.get("cwd"),
        pane=pane, pair=pair, role=role,
    )


def write_snapshot_text(text, session_id, cwd, pane, pair, role):
    """Persist a last-assistant snapshot keyed by session_id. CLI-agnostic."""
    if not text or not text.strip():
        return None
    snap = {
        "session_id": session_id or "unknown",
        "cwd": cwd or os.getcwd(),
        "tmux_pane": pane,
        "pair": pair,
        "role": role,
        "updated_at": now(),
        "last_assistant_text": text[-SNAPSHOT_MAX_CHARS:],
    }
    write_json(SESSIONS_DIR / f"{slugify(snap['session_id'])}.json", snap)
    return snap


def load_snapshots():
    snaps = []
    for path in SESSIONS_DIR.glob("*.json"):
        s = read_json(path)
        if s and s.get("updated_at"):
            snaps.append(s)
    return snaps


def latest_snapshot_for_pane(snaps, pane_id):
    mine = [s for s in snaps if s.get("tmux_pane") == pane_id]
    return max(mine, key=lambda s: s["updated_at"]) if mine else None


# ── pairs & target resolution ────────────────────────────────────────────────

def pair_state(pair):
    return read_json(PAIRS_DIR / f"{pair}.json", {}) or {}


def save_pair_state(pair, state):
    write_json(PAIRS_DIR / f"{pair}.json", state)


def members(panes, pair, role=None):
    return [p for p in panes if p["pair"] == pair and (role is None or p["role"] == role)]


def resolve_target(pair, panes, snaps, sharpen_pane_id=None):
    """Return (pane_id or None, snapshot or None, how) for the pair's current working target.

    how: pinned | latest | neighbor | env | none
    """
    pinned = pair_state(pair).get("pinned_target")
    if pinned and pane_by_id(panes, pinned):
        return pinned, latest_snapshot_for_pane(snaps, pinned), "pinned"

    working_ids = {p["id"] for p in members(panes, pair, "working")}
    cands = [s for s in snaps if s.get("tmux_pane") in working_ids]
    if cands:
        best = max(cands, key=lambda s: s["updated_at"])
        return best["tmux_pane"], best, "latest"
    if working_ids:
        return sorted(working_ids)[0], None, "latest"

    # Paired outside tmux via env vars.
    env_cands = [s for s in snaps if not s.get("tmux_pane") and s.get("pair") == pair
                 and s.get("role") == "working"]
    if env_cands:
        best = max(env_cands, key=lambda s: s["updated_at"])
        return None, best, "env"

    # No working members: fall back to the one other Claude pane in the sharpen pane's window.
    me = pane_by_id(panes, sharpen_pane_id) if sharpen_pane_id else None
    if me:
        others = [p for p in panes if p["window_id"] == me["window_id"] and p["id"] != me["id"]
                  and p["role"] != "sharpen"]
        with_snaps = [(p, latest_snapshot_for_pane(snaps, p["id"])) for p in others]
        with_snaps = [(p, s) for p, s in with_snaps if s]
        if len(with_snaps) == 1:
            p, s = with_snaps[0]
            return p["id"], s, "neighbor"
    return None, None, "none"


def header_line(pair, pane_id, snap, how, previous_pane=None):
    if not snap:
        hint = "run `sharpen pair <pane>` or `sharpen join` in the working pane"
        if pane_id:
            return f"Pair {pair} → {pane_id} (no message yet)"
        return f"Pair {pair} → none ({hint})"
    where = Path(snap.get("cwd") or "?").name
    age = now() - snap["updated_at"]
    bits = [where, age_str(age)]
    if how == "pinned":
        bits.append("pinned")
    if how == "neighbor":
        bits.append("same-window neighbor, not joined")
    if age > STALE_SECONDS:
        bits.append("stale")
    target = pane_id or "env-paired session"
    line = f"Pair {pair} → {target} ({', '.join(bits)})"
    if previous_pane and previous_pane != pane_id:
        line += f" — switched from {previous_pane}"
    return line


# ── message block extraction ─────────────────────────────────────────────────

START_RE = re.compile(r"▼\s*MESSAGE TO COPY\s*[—–-]+\s*(NOT READY|READY)")
END_RE = re.compile(r"▲\s*END OF MESSAGE")
FENCE_RE = re.compile(r"^(\s*)(`{3,}|~{3,})(.*)$")


def extract_message(text):
    """Return (verdict, message) from a sharpen reply, or (None, None) if no block is found.

    Takes the last MESSAGE TO COPY block, then the first fenced code block inside it; the
    closing fence must use the same character, be at least as long as the opening one, and be
    followed by the END OF MESSAGE marker, so inner code fences never truncate the message.
    """
    lines = text.splitlines()
    starts = [i for i, l in enumerate(lines) if START_RE.search(l)]
    if not starts:
        return None, None
    start = starts[-1]
    verdict = START_RE.search(lines[start]).group(1)
    i = start + 1
    while i < len(lines) and not FENCE_RE.match(lines[i]):
        if END_RE.search(lines[i]):
            return verdict, None
        i += 1
    if i >= len(lines):
        return verdict, None
    indent, fence, _ = FENCE_RE.match(lines[i]).groups()
    for j in range(i + 1, len(lines)):
        m = FENCE_RE.match(lines[j])
        if not (m and m.group(2)[0] == fence[0] and len(m.group(2)) >= len(fence)
                and not m.group(3).strip()):
            continue
        # A real closing fence is the one followed by the END marker; a bare fence inside a
        # message wrapped in a too-short fence is part of the message, not its end.
        nxt = next((l for l in lines[j + 1:] if l.strip()), "")
        if not END_RE.search(nxt):
            continue
        body = [l[len(indent):] if indent and l.startswith(indent) else l
                for l in lines[i + 1:j]]
        return verdict, "\n".join(body).strip("\n")
    return verdict, None


# ── hooks ────────────────────────────────────────────────────────────────────

def current_membership(panes=None):
    """(pane_id, pair, role) for the process's pane; env vars apply outside tmux or as default."""
    pane_id = os.environ.get("TMUX_PANE") if in_tmux() else None
    pair = os.environ.get("SHARPEN_PAIR") or None
    role = os.environ.get("SHARPEN_ROLE") or None
    if pane_id:
        if panes is None:
            panes = list_panes()
        p = pane_by_id(panes, pane_id)
        if p and p["pair"]:
            pair, role = p["pair"], p["role"]
    if pair and role not in ROLES:
        role = "working"
    return pane_id, pair, role


def _process_assistant_reply(text, pane_id, pair, role):
    """Shared sharpen-side handling: extract MESSAGE TO COPY, persist, copy, notify.

    Called by both Claude's `Stop` and Cursor's `afterAgentResponse` hooks after they have
    already written the per-session snapshot.
    """
    if role != "sharpen" or not pair:
        return
    verdict, message = extract_message(text or "")
    state = pair_state(pair)
    if verdict is None:
        return  # a clarifying reply, not a sharpen pass
    if not message:
        notify(f"[{pair}] couldn't extract the message block", pane_id)
        return
    write_private(PAIRS_DIR / f"{pair}.last-message.md", message + "\n")
    state["last_copied"] = {"verdict": verdict, "chars": len(message), "at": now(),
                            "copied": verdict == "READY"}
    save_pair_state(pair, state)
    if verdict == "READY":
        displaced = copy_message(message, pair)
        note = f"[{pair}] copied — READY, {len(message)} chars"
        if displaced:
            note += (f"; replaced [{displaced}]'s message "
                     f"(prefix+y in a [{displaced}] pane brings it back)")
        notify(note, pane_id)
    else:
        notify(f"[{pair}] NOT READY — not copied; answer the blocking question "
               f"(or `sharpen copy` to take the best guess)", pane_id)


def hook_stop(event):
    """Claude Code Stop hook."""
    pane_id, pair, role = current_membership()
    if not pair:
        return  # only paired sessions are persisted; the snapshot holds assistant output
    write_snapshot(event, pane_id, pair, role)
    text = event.get("last_assistant_message") or ""
    if not text and event.get("transcript_path"):
        text = last_assistant_from_transcript(event["transcript_path"])
    _process_assistant_reply(text, pane_id, pair, role)


def hook_after_response(event):
    """Cursor CLI `afterAgentResponse` hook. The event includes the assistant text directly."""
    pane_id, pair, role = current_membership()
    if not pair:
        return
    text = event.get("text") or ""
    write_snapshot_text(
        text,
        session_id=event.get("conversation_id") or event.get("session_id", "unknown"),
        cwd=(event.get("workspace_roots") or [None])[0],
        pane=pane_id, pair=pair, role=role,
    )
    _process_assistant_reply(text, pane_id, pair, role)


def hook_session_start(event):
    """Cursor CLI `sessionStart` hook. In a sharpen pane, inject persona + skill pointer.

    Cursor cannot inject context per-turn (`beforeSubmitPrompt` is block-only), so this one
    sessionStart injection is the whole pre-loaded context. The skill itself runs `sharpen last`
    on every pass to pull fresh working-session replies after that.
    """
    pane_id, pair, role = current_membership()
    if role != "sharpen" or not pair:
        return None
    body_path = CURSOR_SESSION_PROMPT
    body = body_path.read_text() if body_path.exists() else ""
    header = f"sharpen_header: paired as sharpen pane for '{pair}'"
    parts = [header, body.strip()] if body else [header]
    # Tack on the current working-session reply so the very first pass doesn't need the shell call.
    snaps = load_snapshots()
    panes = list_panes() if in_tmux() else []
    target, snap, _how = resolve_target(pair, panes, snaps, pane_id)
    if snap:
        parts.append(
            f'<working_session_last_message pair="{pair}" pane="{target or ""}" '
            f'cwd="{snap.get("cwd", "")}" age="{age_str(now() - snap["updated_at"])}">\n'
            f'{snap["last_assistant_text"]}\n</working_session_last_message>'
        )
    return {"continue": True, "additional_context": "\n\n".join(parts)}


DRAFT_MARKER_RE = re.compile(r"^\s*(new|refine)\b\s*(\[voice\])?\s*:", re.I)


def hook_prompt(event):
    """UserPromptSubmit: in sharpen panes, attach the working session's last message."""
    panes = list_panes() if in_tmux() else []
    pane_id, pair, role = current_membership(panes)
    if role != "sharpen" or not pair:
        return None
    snaps = load_snapshots()
    target, snap, how = resolve_target(pair, panes, snaps, pane_id)
    state = pair_state(pair)
    # Keyed by the sharpen session so a restarted or /clear-ed conversation in the same pane
    # gets the message again instead of being told an earlier copy is still current.
    sid = event.get("session_id") or "unknown"
    injected = state.setdefault("injected", {})
    last = injected.get(sid) or {}
    prompt = event.get("prompt", "")
    marker = DRAFT_MARKER_RE.match(prompt)
    is_new = bool(marker and marker.group(1).lower() == "new")
    changed = bool(snap) and (last.get("pane") != target
                              or last.get("updated_at") != snap["updated_at"])
    header = header_line(pair, target, snap, how, previous_pane=last.get("pane"))

    parts = [f"sharpen_header: {header}"]
    if snap and (is_new or changed or not last):
        parts.append(
            f'<working_session_last_message pair="{pair}" pane="{target or ""}" '
            f'cwd="{snap.get("cwd", "")}" age="{age_str(now() - snap["updated_at"])}">\n'
            f'{snap["last_assistant_text"]}\n</working_session_last_message>')
        injected[sid] = {"pane": target, "updated_at": snap["updated_at"], "at": now()}
        for old in sorted(injected, key=lambda k: injected[k].get("at", 0))[:-20]:
            del injected[old]
        save_pair_state(pair, state)
    elif snap:
        parts.append("The working session has not replied since its last message was attached "
                     "earlier in this conversation; that earlier copy is still current.")
    else:
        parts.append("No working-session message is available for this pair.")
    return {"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                   "additionalContext": "\n\n".join(parts)}}


def cmd_hook(args):
    if not args:
        die("hook needs 'stop', 'prompt', 'after_response', or 'session_start'")
    try:
        event = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        event = {}
    try:
        if args[0] == "stop":                    # Claude Code `Stop`
            hook_stop(event)
        elif args[0] == "prompt":                # Claude Code `UserPromptSubmit`
            out = hook_prompt(event)
            if out:
                print(json.dumps(out))
        elif args[0] == "after_response":        # Cursor CLI `afterAgentResponse`
            hook_after_response(event)
        elif args[0] == "session_start":         # Cursor CLI `sessionStart`
            out = hook_session_start(event)
            if out:
                print(json.dumps(out))
    except Exception as e:  # hooks must never break the session
        log(f"hook {args[0]} failed: {e!r}")
    sys.exit(0)


