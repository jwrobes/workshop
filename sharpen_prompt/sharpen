IDLE_WAIT_SECONDS = float(os.environ.get("SHARPEN_IDLE_WAIT", "5"))
PASTE_WAIT_SECONDS = float(os.environ.get("SHARPEN_PASTE_WAIT", "5"))
SUBMIT_WAIT_SECONDS = float(os.environ.get("SHARPEN_SUBMIT_WAIT", "4"))
POLL_SECONDS = 0.15
SNIPPET_CHARS = 30
PROMPT_LINE_RE = re.compile(r"^[ \u00a0]*❯[ \u00a0]*(.*?)[ \u00a0]*$")
QUEUED_HINT_RE = re.compile(r"^Press up to edit queued messages$", re.I)
PASTE_PLACEHOLDER_RE = re.compile(r"\[Pasted text #\d+")


class DeliveryError(Exception):
    def __init__(self, message, kind=""):
        super().__init__(message)
        self.kind = kind


def capture_pane(pane_id):
    return tmux("capture-pane", "-p", "-t", pane_id) or ""


def prompt_state(screen):
    """Classify a Claude pane screen: ('empty'|'text'|'unknown', input text).

    The input box is the last line that starts with the ❯ glyph. Menus and permission dialogs
    also use it ("❯ 1. Yes"), so those count as text rather than an empty prompt. A pane in the
    middle of a pass still accepts input (Claude queues it), so busy is not a separate state;
    the "Press up to edit queued messages" hint shown while something is queued is not typed text.
    """
    lines = [l for l in screen.splitlines() if l.strip()]
    for line in reversed(lines):
        m = PROMPT_LINE_RE.match(line)
        if m:
            typed = m.group(1)
            if not typed or QUEUED_HINT_RE.match(typed):
                return "empty", ""
            return "text", typed
    return "unknown", ""


def paste_visible(screen, payload):
    """True when the input box holds our payload (or Claude's placeholder for a long paste)."""
    state, typed = prompt_state(screen)
    if state != "text":
        return False
    snippet = payload.strip().splitlines()[0][:SNIPPET_CHARS].rstrip()
    return typed.startswith(snippet) or bool(PASTE_PLACEHOLDER_RE.search(typed))


def wait_until(predicate, timeout):
    deadline = time.monotonic() + timeout
    while True:
        if predicate():
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(POLL_SECONDS)


def wait_until_ready(pane_id):
    return wait_until(lambda: prompt_state(capture_pane(pane_id))[0] == "empty", IDLE_WAIT_SECONDS)


def wait_for_paste(pane_id, payload):
    return wait_until(lambda: paste_visible(capture_pane(pane_id), payload), PASTE_WAIT_SECONDS)


def wait_for_submit(pane_id, payload):
    return wait_until(lambda: not paste_visible(capture_pane(pane_id), payload), SUBMIT_WAIT_SECONDS)


def leave_copy_mode(pane_id):
    """A scrolled-back pane swallows Enter, so leave scrollback (or any other pane mode) first."""
    in_mode = (tmux("display-message", "-p", "-t", pane_id, "#{pane_in_mode}") or "").strip()
    if in_mode == "1":
        tmux("copy-mode", "-q", "-t", pane_id)


def find_sharpen_pane(panes, pair=None, from_pane=None):
    """The sharpen pane to deliver to: the named pair's, else the pair of the pane the key was
    pressed in, else (for an unpaired pane) the one sharpen pane in its window, else the only
    sharpen pane on the server. Several candidates mean no answer rather than a guess."""
    origin = pane_by_id(panes, from_pane) if from_pane else None
    if not pair and origin:
        pair = origin["pair"]
    if pair:
        cands = members(panes, pair, "sharpen")
        return (cands[0], pair) if cands else (None, pair)
    if origin:
        local = [p for p in panes if p["role"] == "sharpen" and p["window_id"] == origin["window_id"]]
        if len(local) == 1:
            return local[0], local[0]["pair"]
        if len(local) > 1:
            return None, None
    all_sharpen = [p for p in panes if p["role"] == "sharpen"]
    if len(all_sharpen) == 1:
        return all_sharpen[0], all_sharpen[0]["pair"]
    return None, None


def save_dictation(text, pair):
    """Keep the transcript on disk before any attempt to send it, so a failure never loses it."""
    if pair:
        path = PAIRS_DIR / f"{pair}.last-dictation.md"
    else:
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
        path = STATE_DIR / "dictations" / f"{stamp}-{os.getpid()}.md"
    write_private(path, text + "\n")
    write_pointer(path, "")
    return path


def write_pointer(path, kind):
    """Tell the popup wrapper where the transcript is and why delivery failed ('no-pane' means no
    unambiguous sharpen session, which is the one case where it offers a choice)."""
    pointer = os.environ.get("SHARPEN_DICTATION_PTR")
    if pointer:
        try:
            Path(pointer).write_text(json.dumps({"path": str(path), "kind": kind}))
        except OSError:
            pass


def record_delivery(pair, pane_id, ok, reason, chars, refine):
    log(f"deliver pair={pair or '-'} pane={pane_id or '-'} {'ok' if ok else 'FAILED'} "
        f"chars={chars}" + (f" reason={reason}" if reason else ""))
    if pair:
        write_json(PAIRS_DIR / f"{pair}.last-delivery.json",
                   {"at": now(), "ok": ok, "reason": reason, "chars": chars, "pane": pane_id,
                    "refine": bool(refine)})


def send_to_pane(pane, pair, text, refine, voice):
    """Paste text into the sharpen pane, check it landed in the input box, press Enter, and check
    the box emptied. A pane in the middle of a pass is fine: Claude queues the message."""
    pid = pane["id"]
    # Never type into a shell: a pasted draft would run as commands.
    if pane["command"] != "claude" and not os.environ.get("SHARPEN_DELIVER_ANY"):
        raise DeliveryError(f"sharpen pane {pid} is running '{pane['command']}', not claude; "
                            f"start it with `sharpen session {pair}`")
    leave_copy_mode(pid)
    if not wait_until_ready(pid):
        raise DeliveryError(f"sharpen pane {pid} isn't at an empty Claude prompt (a dialog is "
                            "open or text is half-typed); nothing was sent")
    marker = "refine" if refine else "new"
    if voice:
        marker += " [voice]"
    payload = f"{marker}: {text}"
    # Bracketed paste keeps multi-line text as one prompt instead of submitting at each newline.
    # The buffer is named per pair and process so simultaneous deliveries can't share one.
    buf = f"sharpen-deliver-{pair or 'x'}-{os.getpid()}"
    if tmux("load-buffer", "-b", buf, "-", input_text=payload) is None \
            or tmux("paste-buffer", "-p", "-d", "-b", buf, "-t", pid) is None:
        tmux("delete-buffer", "-b", buf)
        raise DeliveryError(f"couldn't paste into {pid}")
    if not wait_for_paste(pid, payload):
        raise DeliveryError(f"the draft never showed up in {pid}'s input box, so Enter was not "
                            "sent; check that pane")
    tmux("send-keys", "-t", pid, "Enter")
    if not wait_for_submit(pid, payload):
        raise DeliveryError(f"Enter was sent but the draft is still in {pid}'s input box; check "
                            "that pane (it may be in a menu)")
    return len(payload)


def deliver(text, pair_name, from_pane, refine, voice):
    pane = pair = None
    if in_tmux():
        pane, pair = find_sharpen_pane(list_panes(), pair_name, from_pane)
    saved = save_dictation(text, pair) if voice else None
    chars = len(text)
    try:
        if not in_tmux():
            raise DeliveryError("deliver needs tmux")
        if not pane:
            raise DeliveryError("no sharpen pane found for "
                                + (f"'{pair}'" if pair else "this pane (not in a pair)"),
                                kind="no-pane")
        chars = send_to_pane(pane, pair, text, refine, voice)
    except DeliveryError as e:
        record_delivery(pair, pane and pane["id"], False, str(e), chars, refine)
        if saved and e.kind:
            write_pointer(saved, e.kind)
        note = ""
        if saved:
            note = f" Your dictation is saved at {saved}"
            note += "; `sharpen resend` sends it again." if pair else "."
        die(f"{e}.{note}", 3)
    record_delivery(pair, pane["id"], True, "", chars, refine)
    print(f"Delivered and submitted to [{pair} · sharpen] {pane['id']} ({chars} chars).")


def cmd_deliver(args):
    opts, _ = parse_flags(args, flags_with_values=("--pair", "--from-pane"),
                          bool_flags=("--refine", "--voice"))
    text = sys.stdin.read().strip()
    if not text:
        die("nothing to deliver (empty stdin)")
    pair = slugify(opts["--pair"]) if opts.get("--pair") else None
    deliver(text, pair, opts.get("--from-pane") or os.environ.get("TMUX_PANE"),
            bool(opts.get("--refine")), bool(opts.get("--voice")))


def cmd_resend(args):
    opts, _ = parse_flags(args, flags_with_values=("--pair", "--from-pane"), bool_flags=("--force",))
    from_pane = opts.get("--from-pane") or os.environ.get("TMUX_PANE")
    pair = slugify(opts["--pair"]) if opts.get("--pair") else None
    if not pair:
        _, pair = find_sharpen_pane(list_panes() if in_tmux() else [], None, from_pane)
    if not pair:
        die("which pair? run it from a pane in a pair, or pass --pair NAME")
    path = PAIRS_DIR / f"{pair}.last-dictation.md"
    if not path.exists():
        die(f"no saved dictation for '{pair}'")
    last = read_json(PAIRS_DIR / f"{pair}.last-delivery.json") or {}
    if last.get("ok") and not opts.get("--force"):
        die(f"the last dictation for '{pair}' was already delivered; --force sends it again")
    deliver(path.read_text().strip(), pair, from_pane, bool(last.get("refine")), True)


def offer_clipboard(path, ask=input):
    """After a failed voice delivery, ask whether to put the saved transcript on the clipboard.

    Never silent: the clipboard may hold a sharpened message from a pair that hasn't been pasted
    yet, so the prompt names it. Returns True if the transcript was copied."""
    text = Path(path).read_text().strip()
    holder = pending_pair()
    warn = (f" This replaces [{holder}]'s sharpened message (prefix+y in a [{holder}] pane brings "
            "it back).") if holder else ""
    answer = ask(f"\nCopy the transcript to the clipboard so you can paste it yourself?{warn} [y/N] ")
    if answer.strip().lower() not in ("y", "yes"):
        return False
    write_clipboard(text)
    (STATE_DIR / "clipboard.json").unlink(missing_ok=True)
    return True


def choose_target(path, refine, ask=input, show=print):
    """The transcript couldn't be matched to one sharpen session. List them and let the user pick,
    or copy to the clipboard, or skip. Returns 'delivered', 'copied', or 'skipped'."""
    text = Path(path).read_text().strip()
    sharpen_panes = sorted((p for p in list_panes() if p["role"] == "sharpen" and p["pair"]),
                           key=lambda p: (p["pair"], p["id"]))
    if not sharpen_panes:
        return "copied" if offer_clipboard(path, ask=ask) else "skipped"
    show("\nWhich sharpen session should get it?")
    for i, p in enumerate(sharpen_panes, 1):
        show(f"  {i}) [{p['pair']}]  {p['session']}:{p['window_index']}.{p['pane_index']}  "
             f"{Path(p['cwd']).name}")
    holder = pending_pair()
    warn = f" (replaces [{holder}]'s pending message)" if holder else ""
    prompt = f"Number to send, c = copy to clipboard{warn}, Enter = skip: "
    for _ in range(5):
        answer = ask(prompt).strip().lower()
        if not answer:
            return "skipped"
        if answer == "c":
            write_clipboard(text)
            (STATE_DIR / "clipboard.json").unlink(missing_ok=True)
            return "copied"
        if answer.isdigit() and 1 <= int(answer) <= len(sharpen_panes):
            chosen = sharpen_panes[int(answer) - 1]
            try:
                deliver(text, chosen["pair"], None, refine, True)
                return "delivered"
            except SystemExit:
                show("That one didn't take it either (reason above).")
                continue
        show("Type one of the numbers, c, or just Enter.")
    return "skipped"


def cmd_dictate(args):
    if not DICTATE.exists():
        die(f"dictate not found at {DICTATE}")
    opts, rest = parse_flags(args, flags_with_values=("--from-pane",), bool_flags=("--refine",))
    cmd = [str(DICTATE), "--to-sharpen"]
    if opts.get("--refine"):
        cmd.append("--refine")
    if opts.get("--from-pane"):
        cmd += ["--from-pane", opts["--from-pane"]]
    cmd += rest
    fd, pointer = tempfile.mkstemp(prefix="sharpen-dictation-")
    os.close(fd)
    # Ctrl-C (which stops the recording) reaches the whole popup's process group. If Python
    # took it too, subprocess would kill dictate mid-transcription, so ignore it here only;
    # the child keeps the default handler because it was spawned first.
    child = subprocess.Popen(cmd, env=dict(os.environ, SHARPEN_DICTATION_PTR=pointer))
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    rc = child.wait()
    info = read_json(pointer) or {}
    Path(pointer).unlink(missing_ok=True)
    saved, kind = info.get("path"), info.get("kind", "")
    if rc == 3 and saved and sys.stdin.isatty():
        try:
            if kind == "no-pane":
                outcome = choose_target(saved, bool(opts.get("--refine")))
            else:
                outcome = "copied" if offer_clipboard(saved) else "skipped"
        except EOFError:
            outcome = "skipped"
        if outcome in ("delivered", "copied"):
            print("Done." if outcome == "delivered" else "Copied. Paste it wherever you like.")
            time.sleep(1.5)
            sys.exit(0)
        print(f"Not sent. The transcript is saved at {saved}")
    if rc != 0 or os.environ.get("SHARPEN_POPUP_PAUSE"):
        # Keep a popup open long enough to read an error before it closes.
        try:
            input("\n[press Enter to close]")
        except EOFError:
            pass
    sys.exit(rc)


def cmd_gc(_args):
    removed = 0
    for path in SESSIONS_DIR.glob("*.json"):
        s = read_json(path)
        if not s or now() - s.get("updated_at", 0) > SNAPSHOT_TTL_SECONDS:
            path.unlink(missing_ok=True)
            removed += 1
    for path in (STATE_DIR / "dictations").glob("*.md"):
        if now() - path.stat().st_mtime > SNAPSHOT_TTL_SECONDS:
            path.unlink(missing_ok=True)
            removed += 1
    print(f"Removed {removed} snapshot(s) and saved transcript(s) older than 24h.")


COMMANDS = {
    "session": cmd_session, "join": cmd_join, "leave": cmd_leave, "pair": cmd_pair,
    "pin": cmd_pin, "unpin": lambda a: cmd_pin(a, unpin=True), "pairs": cmd_pairs,
    "status": cmd_status, "copy": cmd_copy, "last": cmd_last, "deliver": cmd_deliver,
    "resend": cmd_resend,
    "dictate": cmd_dictate, "gc": cmd_gc, "--gc": cmd_gc, "hook": cmd_hook,
}


CHEATSHEET = """\
